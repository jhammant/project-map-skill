// GitHub issues and Actions runs, so the project-map agent can read a project's
// open work through Orbital instead of calling GitHub itself. "githubApi" is a
// placeholder host: point it at https://api.github.com in services.conf (and add
// a token in Orbital's auth config for private repositories).

import taxi.http.HttpOperation
import taxi.http.PathVariable

namespace github

type RepoOwner inherits String
type RepoName inherits String
type IssueNumber inherits Int
type IssueTitle inherits String
type IssueState inherits String
type IssueUrl inherits String
type IssueAuthor inherits String
type IssueUpdatedAt inherits Instant
type RunName inherits String
type RunStatus inherits String
type RunConclusion inherits String
type RunSha inherits String
type RunUrl inherits String
type RunCreatedAt inherits Instant

model Issue {
  number : IssueNumber
  title : IssueTitle
  state : IssueState
  url : IssueUrl by jsonPath("$.html_url")
  author : IssueAuthor by jsonPath("$.user.login")
  updatedAt : IssueUpdatedAt by jsonPath("$.updated_at")
}

model WorkflowRun {
  name : RunName
  status : RunStatus
  conclusion : RunConclusion?
  sha : RunSha by jsonPath("$.head_sha")
  url : RunUrl by jsonPath("$.html_url")
  createdAt : RunCreatedAt by jsonPath("$.created_at")
}

// Nested arrays bind by field name, so this must match GitHub's key exactly.
model WorkflowRuns {
  workflow_runs : WorkflowRun[]
}

service GitHubApi {
  @HttpOperation(method = "GET", url = "http://githubApi/repos/{owner}/{repo}/issues?state=open&per_page=50")
  operation listOpenIssues(@PathVariable("owner") owner : RepoOwner, @PathVariable("repo") repo : RepoName) : Issue[]

  @HttpOperation(method = "GET", url = "http://githubApi/repos/{owner}/{repo}/actions/runs?per_page=10")
  operation listWorkflowRuns(@PathVariable("owner") owner : RepoOwner, @PathVariable("repo") repo : RepoName) : WorkflowRuns
}
